+        deadline = time.monotonic() + 2.0
+        previous: Optional[Tuple[int, int, int, int]] = None
+        stable_observations = 0
+        while time.monotonic() < deadline:
+            geometry = self.get_geometry(label)
+            self.require_native_geometry(geometry, label)
+            signature = tuple(geometry[key] for key in ("x", "y", "width", "height"))
+            stable_observations = stable_observations + 1 if signature == previous else 1
+            if stable_observations >= 2:
+                return geometry
+            previous = signature
+            time.sleep(0.05)
