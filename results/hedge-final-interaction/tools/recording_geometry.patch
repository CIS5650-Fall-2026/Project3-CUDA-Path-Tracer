+def parse_xwininfo_geometry(text: str) -> Dict[str, int]:
+    """Read root-relative client coordinates, never parent-relative coordinates."""
+    labels = {
+        "Absolute upper-left X": "x",
+        "Absolute upper-left Y": "y",
+        "Width": "width",
+        "Height": "height",
+    }
+    values: Dict[str, int] = {}
+    windows: List[int] = []
+    map_states: List[str] = []
+    for line in text.splitlines():
+        field = re.fullmatch(
+            r"\s*(Absolute upper-left X|Absolute upper-left Y|Width|Height)\s*:\s*(.*?)\s*",
+            line,
+        )
+        if field is not None:
+            key = labels[field.group(1)]
+            if key in values or re.fullmatch(r"[+-]?[0-9]+", field.group(2)) is None:
+                raise RecordingError(f"duplicate or invalid xwininfo field: {line!r}")
+            values[key] = int(field.group(2), 10)
+        window = re.fullmatch(
+            r"\s*xwininfo: Window id:\s*(0x[0-9a-fA-F]+|[0-9]+)(?:\s+.*)?",
+            line,
+        )
+        if window is not None:
+            windows.append(parse_window_id(window.group(1)))
+        mapped = re.fullmatch(r"\s*Map State:\s*(.*?)\s*", line)
+        if mapped is not None:
+            map_states.append(mapped.group(1))
+    if set(values) != {"x", "y", "width", "height"}:
+        raise RecordingError("xwininfo omitted required absolute client geometry")
+    if values["width"] <= 0 or values["height"] <= 0:
+        raise RecordingError("xwininfo reported nonpositive client dimensions")
+    if len(windows) != 1 or windows[0] <= 0:
+        raise RecordingError("xwininfo did not uniquely identify its client window")
+    if map_states != ["IsViewable"]:
+        raise RecordingError("xwininfo client must be uniquely reported as IsViewable")
+    values["window"] = windows[0]
     return values
 
 
