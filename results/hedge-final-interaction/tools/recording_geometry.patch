+    def wait_for_stable_geometry(self, label: str) -> Dict[str, int]:
+        # Placement happens before capture and before the interaction epoch.
+        # A plain move request avoids xdotool --sync waiting on its incorrect
+        # parent-relative geometry interpretation under this GNOME session.
